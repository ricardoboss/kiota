@page "/"
@using System.Diagnostics
@using System.IO.Compression
@using Kiota.Builder
@using Kiota.Builder.Configuration
@inject HttpClient client;
@inject IJSRuntime JS;

<InputText @bind-Value="SpecUrl" DisplayName="Spec URL"></InputText>
<button @onclick="Generate">Generate</button>

<pre>@FilesystemLog</pre>

<script>
    window.downloadFileFromStream = async (fileName, contentStreamReference) => {
        const arrayBuffer = await contentStreamReference.arrayBuffer();
        console.log("buffer size: ", arrayBuffer.byteLength);
        const blob = new Blob([arrayBuffer]);
        const url = URL.createObjectURL(blob);
        const anchorElement = document.createElement('a');
        anchorElement.href = url;
        anchorElement.download = fileName ?? '';
        anchorElement.click();
        anchorElement.remove();
        URL.revokeObjectURL(url);
    }
</script>

@code{

    private string SpecUrl { get; set; }

    private string FilesystemLog { get; set; } = string.Empty;

    async Task Generate()
    {
        FilesystemLog = string.Empty;

        var sw = new Stopwatch();
        sw.Start();

        Log("Generating...");

        var filesystem = new InMemoryFilesystem();
        filesystem.NodeCreated += (_, e) => Log($"+{(e.IsDirectory ? "d" : "f")} {e.Path}/{e.Name}");
        filesystem.NodeDeleted += (_, e) => Log($"-{(e.IsDirectory ? "d" : "f")} {e.Path}/{e.Name}");

        var config = new GenerationConfiguration
        {
            Filesystem = filesystem,
            OpenAPIFilePath = SpecUrl,
        };

        var logger = new StringLogger<KiotaBuilder>(Log);
        var builder = new KiotaBuilder(logger, config, client);
        await builder.GenerateClientAsync(CancellationToken.None);

        Log("Generation complete. Zipping...");

        await using var zipStream = CreateZipArchive(filesystem);

        Log("Zipping complete. Downloading...");

        await DownloadFileFromStream(zipStream);

        Log("Done.");

        return;

        void Log(string message) => FilesystemLog += $"{sw.Elapsed:mm\\:ss\\.fff} {message}\n";
    }

    private static Stream CreateZipArchive(InMemoryFilesystem filesystem)
    {
        var zipStream = new MemoryStream();

        using (var zipArchive = new ZipArchive(zipStream, ZipArchiveMode.Create, leaveOpen: true))
        {
            foreach (var path in filesystem.EnumerateFiles("~", recursive: true))
            {
                var entry = zipArchive.CreateEntry(path[2..]); // cut off the leading "~/"
                using var entryStream = entry.Open();
                using var fileStream = filesystem.OpenRead(path);

                fileStream.CopyTo(entryStream);
            }
        }

        zipStream.Position = 0;

        return zipStream;
    }

    private async Task DownloadFileFromStream(Stream stream)
    {
        const string fileName = "kiota.zip";

        using var streamRef = new DotNetStreamReference(stream: stream, leaveOpen: true);

        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }

    class StringLogger<T>(Action<string> onLog) : ILogger<T>
    {
        public void Log<TState>(LogLevel logLevel, EventId eventId, TState state, Exception? exception, Func<TState, Exception?, string> formatter)
        {
            var message = formatter(state, exception);

            onLog(message);
        }

        public bool IsEnabled(LogLevel logLevel) => true;

        public IDisposable? BeginScope<TState>(TState state) where TState : notnull => null;
    }
}
